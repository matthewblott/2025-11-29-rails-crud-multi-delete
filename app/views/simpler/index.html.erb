<%= turbo_stream_from :posts_after_create_stream %>

<section id="posts_element">
  <div data-controller="posts" data-posts-target="controller">

    <%= button_tag "Select all",
      data: {
        action: 'posts#toggleSelection'
      }
    %>

    <%= button_to simpler_index_path, data: { posts_target: "delete" }, method: :delete do %>
      Delete
    <% end %>

    <% @posts.each do |post| %>
      <%= render partial: "simpler/post", locals: { post: post } %>
    <% end %>
  </div>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: simpler_index_path(page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
