<h1>Posts</h1>

<%= turbo_stream_from :posts_after_create_stream %>

<section id="posts_element">
  <div data-controller="posts">

    <%= button_tag "Select all",
      data: {
        controller: "select-all",
        action: 'posts#toggleSelection'
      }
    %>

    <%= button_tag "Delete",
      data: {
        controller: "delete-button",
        action: "posts:enable@window->delete-button#enable delete-button#bulkDelete"
      },
      disabled: true,
      form: "delete-form"
    %>

    <%= link_to :New, new_post_path(@post) %>

    <%= form_with url: posts_path,
      method: :delete,
      data: {
        controller: 'delete-form',
        action: "
          posts:addField@window->delete-form#addField
          posts:removeField@window->delete-form#removeField
          delete-button:submit@window->delete-form#submit
        "
      },
      id: "delete-form" do |f| %>
    <% end %>

    <% @posts.each do |post| %>
      <%= render partial: "posts/post", locals: { post: post } %>
    <% end %>
  </div>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: posts_path(page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
