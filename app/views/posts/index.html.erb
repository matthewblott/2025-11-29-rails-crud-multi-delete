<h1>Posts</h1>

<%= turbo_stream_from :posts_after_create_stream %>

<%= button_tag "Select all",
  data: {
    controller: "ui--toggle-selection",
    action: "ui--toggle-selection#toggle"
  }
%>

<%= button_tag "Delete",
  data: {
    controller: "ui--delete-button",
    action: "
      ui--delete-form:updated@window->ui--delete-button#update
      ui--delete-button#submit
      ui--items:updated@window->ui--delete-button#update
    "
  },
  disabled: true,
  form: "ui--delete-form"
%>

<%= link_to :New, new_post_path(@post) %>

<%= form_with url: posts_path,
  method: :delete,
  data: {
    controller: 'ui--delete-form',
    action: "
      ui--delete-button:submit@window->ui--delete-form#submit
      ui--items:updated@window->ui--delete-form#update
    "
  },
  id: "ui--delete-form" do |f| %>
<% end %>

<section id="posts_element" data-controller="posts-x">
  <div
    data-controller="ui--items"
    data-action="
      ui--toggle-selection:toggle@window->ui--items#toggle
      ui--items#toggle
    "
  >
    <% @posts.each do |post| %>
      <%= render partial: "posts/post", locals: { post: post } %>
    <% end %>
  </div>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: posts_path(page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
